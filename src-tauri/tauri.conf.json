{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MemPilot",
  "version": "0.1.0",
  "identifier": "dev.mempilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "MemPilot", "width": 1080, "height": 760, "minWidth": 880, "minHeight": 620, "visible": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
